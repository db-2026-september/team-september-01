Table trainer {
  id integer [primary key]
  first_name varchar
  last_name varchar
  speciality varchar
  phone varchar
  email varchar
  status varchar
}

Table trainer_availability {
  id integer [primary key]
  trainer_id integer [not null]
  day_of_week varchar
  start_time time
  end_time time
  is_available boolean
}

Table class {
  id integer [primary key]
  class_name varchar
  description text
  level varchar
  capacity integer
  duration integer
}

Table trainer_class {
  trainer_id integer [not null]
  class_id integer [not null]
  assigned_date date

  indexes {
    (trainer_id, class_id) [pk]
  }
}

Table personal_training {
  id integer [primary key]
  trainer_id integer [not null]
  visitor_id integer [not null]
  start_date_time timestamp
  duration integer
  status varchar
  notes text
}

Table visitor {
  id integer [primary key]
  first_name varchar
  last_name varchar
  phone varchar
  email varchar
  date_of_birth date
  status varchar
}
Ref: trainer_availability.trainer_id > trainer.id
Ref: trainer_class.trainer_id > trainer.id
Ref: trainer_class.class_id > class.id
Ref: personal_training.trainer_id > trainer.id
Ref: personal_training.visitor_id > visitor.id




